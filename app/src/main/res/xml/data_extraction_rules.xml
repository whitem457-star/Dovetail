<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same rule for Google backup (skipped if it can't be end-to-end encrypted) and for
     phone-to-phone transfer. WebView storage and settings are left out on purpose: the JSON backups
     restore reliably on any phone, and the app offers to restore the newest one on first launch. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>

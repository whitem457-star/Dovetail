<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- No INTERNET permission: the app never goes online.
         USE_BIOMETRIC comes from androidx.biometric for the optional app lock (granted at install, no prompt).
         USE_FINGERPRINT is only for Android 8 and older, which this app doesn't support, so it's removed. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <!-- Optional reminder notifications (2.2): asked for only when they're switched on in Settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager (the daily reminder check) also brings RECEIVE_BOOT_COMPLETED and WAKE_LOCK, granted without asking,
         so the check survives a restart. It would also add these two, which Dovetail doesn't use: removed. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Opening a Dovetail backup file tapped in another app (WhatsApp, Files, email) or shared to Dovetail. It passes the
             file to the one Dovetail screen. The content is checked before anything is offered; files that aren't a
             Dovetail backup are refused. No permission is needed. -->
        <activity
            android:name=".OpenFileActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Only JSON when shared: text/plain here would put Dovetail in every share menu for any text or link. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
        <!-- WorkManager's foreground-work service: Dovetail never runs foreground work. -->
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" tools:node="remove" />
        <!-- Lets the share sheet read a file the app has just written; nothing else is exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
